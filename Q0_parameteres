{"cells":[{"cell_type":"markdown","source":["# Q0_parameters\n","Grafico de como cambia la capacidad de invasion del mosquito con la temperatura y la duracion de la sequia."],"metadata":{"id":"1n7hhFNgH5gt"}},{"cell_type":"code","execution_count":1,"metadata":{"id":"ta_7Jb_Nn5Sw","executionInfo":{"status":"ok","timestamp":1794322545930,"user_tz":180,"elapsed":7240,"user":{"displayName":"Alejandro Daniel Reckziegel Benitez","userId":"18117090877953780495"}}},"outputs":[],"source":["import sympy as sp\n","import numpy as np\n","import matplotlib.pyplot as plt"]},{"cell_type":"markdown","source":["# Funciones para parametros entomologicos"],"metadata":{"id":"4l0Jn6rpKDU1"}},{"cell_type":"code","execution_count":2,"metadata":{"id":"0mu9vcI1n6pl","executionInfo":{"status":"ok","timestamp":1794322545943,"user_tz":180,"elapsed":8,"user":{"displayName":"Alejandro Daniel Reckziegel Benitez","userId":"18117090877953780495"}}},"outputs":[],"source":["# Modelo de tasas de desarrollo\n","def develop_rates(x, sigma, a, b, temp_1_2):\n","  return sigma * ( ( x / 298 ) * np.exp( ( a / R ) * ( 1 / 298 - 1 / x) ) ) / ( 1 + np.exp ( ( b / R ) * ( 1 / temp_1_2 - 1 / x) ) )\n","\n","# Modelo de perdida de viabilidad\n","def vial(x, b):\n","    return np.exp(-b * x)"]},{"cell_type":"markdown","source":["# Parametros para el moddelo"],"metadata":{"id":"hxAD-FSPKkAx"}},{"cell_type":"code","execution_count":3,"metadata":{"id":"7_CzMgDInrHA","executionInfo":{"status":"ok","timestamp":1794322545944,"user_tz":180,"elapsed":8,"user":{"displayName":"Alejandro Daniel Reckziegel Benitez","userId":"18117090877953780495"}}},"outputs":[],"source":["# Numero de Boltzmann\n","R = 8.31446261815324\n","\n","# Eclosión\n","sigma_1 = 0.01066*24\n","a_1 = 10798.18\n","b_1 = 100000\n","temp_1_2_1 = 14184.50\n","params_e = [sigma_1, a_1, b_1, temp_1_2_1]\n","\n","# Viabilidad\n","params_vial = [0.0737]\n","\n","# Pupacion\n","sigma_2 = 0.00873*24\n","a_2 = 26018.51\n","b_2 = 55990.75\n","temp_1_2_2 = 304.58\n","params_l = [sigma_2, a_2, b_2, temp_1_2_2]\n","\n","# Desarrollo de la pupa\n","sigma_3 = 0.01610*24\n","a_3 = 14931.94\n","b_3 = -472379.00\n","temp_1_2_3 = 148.45\n","params_p = [sigma_3, a_3, b_3, temp_1_2_3]\n","\n","# Tasa de oviposicion\n","phi_coefficients = [-1.515e-4, 1.015e-2, -2.124e-1, 1.8, -5.4]\n","p_fi = np.poly1d(phi_coefficients)\n","\n","# Mortalidad de la hembra\n","mu_m_coefficients = [3.809e-6, -3.408e-4, 1.116e-2, -1.590e-1, 8.692e-1]\n","p_u_m = np.poly1d(mu_m_coefficients)\n","\n","# Mortalidad de la larva\n","mu_l_coefficients = [7.503e-6, -7.538e-4,2.735e-2, -4.191e-1, 2.315]\n","p_u_l = np.poly1d(mu_l_coefficients)\n","\n","# Mortalidad de la pupa\n","mu_p_coefficients = [4.395e-7,7.060e-4, -3.248e-2,4.256e-1]\n","p_u_p = np.poly1d(mu_p_coefficients)\n","\n","# Mortalidad de huevos\n","u_e = 0.01"]},{"cell_type":"markdown","source":["# Calculo de parametros"],"metadata":{"id":"44NfPI5NMmqr"}},{"cell_type":"code","execution_count":4,"metadata":{"id":"cGk8NjwYn-Qe","executionInfo":{"status":"ok","timestamp":1794322545947,"user_tz":180,"elapsed":8,"user":{"displayName":"Alejandro Daniel Reckziegel Benitez","userId":"18117090877953780495"}}},"outputs":[],"source":["# Temperatura\n","tempi = np.linspace(0, 50, 2000)\n","tempi_k = tempi + 273.15\n","\n","# Funcion de perdida de viabilidad\n","e = []\n","taus = [0, 30, 60, 90, 120]\n","for tau in taus:\n","  e.append(vial(tau,*params_vial))\n","\n","# Parametros\n","sigma_e = develop_rates(tempi_k,*params_e)\n","sigma_l = develop_rates(tempi_k,*params_l)\n","sigma_p = develop_rates(tempi_k,*params_p)\n","fi = np.maximum(p_fi(tempi), 0)\n","u_l = np.maximum(p_u_l(tempi), 0)\n","u_p = np.maximum(p_u_p(tempi), 0)\n","u_m = np.maximum(p_u_m(tempi), 0)"]},{"cell_type":"code","source":["# Calculo de Q_0\n","Q_0=[]\n","\n","for tau in taus:\n","    e=vial(tau,*params_vial)\n","    sigma_e_efect=sigma_e*e\n","    Q_0.append((fi*sigma_p*sigma_l*sigma_e_efect)/(2*u_m*(sigma_p+u_p)*(sigma_l+u_l)*(sigma_e_efect+u_e)))\n"],"metadata":{"id":"s1Cd_OdgremV","executionInfo":{"status":"ok","timestamp":1794322545951,"user_tz":180,"elapsed":1,"user":{"displayName":"Alejandro Daniel Reckziegel Benitez","userId":"18117090877953780495"}}},"execution_count":5,"outputs":[]},{"cell_type":"markdown","source":["# Grafico con distintos $\\tau$"],"metadata":{"id":"CoNhPEijSQIA"}},{"cell_type":"code","execution_count":6,"metadata":{"id":"ZyNdCRc0R9fZ","executionInfo":{"status":"ok","timestamp":1794322545955,"user_tz":180,"elapsed":4,"user":{"displayName":"Alejandro Daniel Reckziegel Benitez","userId":"18117090877953780495"}}},"outputs":[],"source":["plt.rcParams.update({'font.size': 22})"]},{"cell_type":"code","source":["fig = plt.figure(figsize=(8, 4.5))\n","ax = fig.add_subplot(111)\n","\n","colors = plt.cm.coolwarm(np.linspace(0, 1, len(Q_0)))\n","\n","for i, tau in enumerate(taus):\n","  ax.plot(tempi, Q_0[i], color = colors[i], lw=2, label='tau='+str(tau), linestyle='-')\n","\n","# Hallar el maximo\n","max_idx = np.argmax(Q_0[0])\n","max_temp = tempi[max_idx]\n","max_value = Q_0[0][max_idx]\n","\n","# Poner marcador\n","ax.plot(max_temp, max_value, 'ro', markersize=8, markerfacecolor='red', markeredgecolor='black')\n","\n","# Agregar texto\n","max_text = f\"Max at T = {max_temp:.3f}°C\\nQ₀ = {max_value:.3f}\"\n","ax.text(0.02, 0.02, max_text, transform=ax.transAxes, fontsize=12,\n","        verticalalignment='bottom', horizontalalignment='left',\n","        bbox=dict(boxstyle=\"round\", facecolor=\"lightblue\", alpha=1))\n","\n","ax.set_xlabel('Temperature [$°C$]')\n","ax.set_ylabel('$Q_0$')\n","ax.set(xlim=(14, 36))\n","legend = ax.legend()\n","legend.get_frame().set_alpha(0.5)\n","plt.legend(loc=\"upper left\", fontsize=\"12\")\n","plt.grid()\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":460},"id":"QlYVGo7gFL_y","executionInfo":{"status":"ok","timestamp":1794322546538,"user_tz":180,"elapsed":582,"user":{"displayName":"Alejandro Daniel 